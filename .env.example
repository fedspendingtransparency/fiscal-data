
#Copy this file to '.env' and fill in your own values. '.env' is git-ignored, never commit real keys
#See "API Keys for Local Builds" in the README. Builds work without these; they fall back to the
#committed sample response, so CPI and GDP figures will be out fo dte but the site will build.

#Bureau of Labor Statistics, CPI data on the inflation explainer.
#Register (free, instant); https://data.bls.gov/registrationEngine/


BLS_API_KEY=

#Bureau of Economic Analysis, GDP data on the revenue/spending explainers.
#Register (free, instant); https://apps.bea.gov/API/signup/

BEA_USER_ID=
